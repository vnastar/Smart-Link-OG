# ============================================================================
# Cấu hình Máy chủ & Môi trường (Server & Environment)
# ============================================================================
NODE_ENV="development"
PORT=3000

# APP_URL: Domain hệ thống (để trống sẽ tự động nhận diện theo request)
# APP_URL="https://domain-cua-ban.com"

# Tùy chọn URL API phía Client (Dùng cho Frontend khi tách rời Backend)
# VITE_API_URL="https://api.domain-cua-ban.com"

# ============================================================================
# Cấu hình Cơ sở dữ liệu MySQL / MariaDB (Tùy chọn)
# ============================================================================
# Đặt DB_TYPE="mysql" để kết nối MySQL/MariaDB, hoặc "json" / để trống để dùng File Local (data/store.json)
DB_TYPE="mysql"

# Cấu hình chuẩn MySQL_*:
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="sls_db"

# Hỗ trợ tên biến dạng DB_* (Tương thích Hosting / cPanel / Shared Host):
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASS="your_mysql_password"
DB_PASSWORD="your_mysql_password"
DB_NAME="sls_db"

# ============================================================================
# Cấu hình Lưu trữ & Tệp tin (Uploads & Storage)
# ============================================================================
# Thư mục lưu trữ ảnh tải lên (Mặc định: ./data/uploads)
# UPLOADS_DIR="/var/www/uploads"

# ============================================================================
# Cấu hình API Khác
# ============================================================================
# GEMINI_API_KEY: Tự động inject trên AI Studio hoặc điền API Key từ Google AI Studio
GEMINI_API_KEY=""

