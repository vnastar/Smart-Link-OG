# ============================================================================
# Cấu hình Cơ sở dữ liệu MySQL / MariaDB (Tùy chọn)
# ============================================================================
# Nếu để trống hoặc DB_TYPE="json", hệ thống sẽ lưu dữ liệu vào data/store.json
# Để sử dụng MySQL, đặt DB_TYPE="mysql" và điền thông tin bên dưới:

DB_TYPE="mysql"

# Địa chỉ Host MySQL (localhost, 127.0.0.1, hoặc IP/domain máy chủ DB):
MYSQL_HOST="localhost"
MYSQL_PORT=3306

# Tên người dùng MySQL (ví dụ trên cPanel: u202109230_admin):
MYSQL_USER="root"

# Mật khẩu người dùng MySQL:
MYSQL_PASSWORD="your_mysql_password"

# Tên Cơ sở dữ liệu MySQL (ví dụ trên cPanel: u202109230_sls_db):
MYSQL_DATABASE="sls_db"

# Hỗ trợ dạng tên biến DB_HOST / DB_USER / DB_PASS / DB_NAME (Cú pháp Hosting):
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASS="your_mysql_password"
DB_NAME="sls_db"

# ============================================================================
# Cấu hình API Khác
# ============================================================================
# GEMINI_API_KEY: Tự động inject trên AI Studio
GEMINI_API_KEY=""

# APP_URL: Domain hệ thống
APP_URL="https://sls.vnastar.com"

# Tùy chọn URL API phía Client (nếu triển khai Tách rời Frontend/Backend)
# VITE_API_URL="https://api.vnastar.com"
